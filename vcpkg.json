{
  "name": "arxx",
  "version": "0.90",
  "description": "Alternate Reality X - SDL2/bgfx web port",
  "dependencies": [
    "bgfx",
    "sdl2",
    {
      "name": "sdl2-image",
      "features": [
        "libjpeg-turbo"
      ]
    },
    {
      "name": "sdl2-mixer",
      "features": [
        "mpg123",
        "libflac",
        "libmodplug",
        "opusfile"
      ]
    },
    {
      "name": "sfml",
      "features": [
        "graphics",
        "window",
        "audio",
        "network"
      ]
    },
    "openssl",
    "glfw3",
    "glew",
    "cpp-base64"
  ]
}

